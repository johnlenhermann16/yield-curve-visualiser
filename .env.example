# Copy to .env and fill in real values. Never commit .env.

# FRED API key (free): https://fred.stlouisfed.org/docs/api/api_key.html
# Used by the US fetcher and by seed_supabase.py.
FRED_API_KEY=

# Supabase project credentials (Settings > API in the Supabase dashboard).
# Required only to run seed_supabase.py, which populates the tables the
# deployed frontend reads from. Not required to run the FastAPI backend
# itself.
SUPABASE_URL=
SUPABASE_KEY=
