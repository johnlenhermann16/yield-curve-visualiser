# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Local secrets / env files
.env
.env.*
!.env.example

# On-disk fetch caches (re-downloaded at runtime; the BoE zip alone is ~39 MB
# and must never be committed)
data/cache/

# Claude Code local machine config (permissions, scheduler lock)
.claude/

# OS cruft
.DS_Store
Thumbs.db

# Downloaded agent skills — vendored content (2.5MB, 322 files), like node_modules
.agents/
skills-lock.json

# Seeded design-canvas output: a build artifact, ~2.4MB, regenerated by
# seed-canvas.mjs from the .dc.html sources beside it
design/yield-curve-light-redesign.html
